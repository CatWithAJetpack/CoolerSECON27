<?xml version="1.0"?>
<!--
  SoutheastCon 2027 Stock Car Race field.
  Units: meters. Board top surface is z = 0.
  Frame: origin at the board center. +x across the 48 in width.
  +y along the 96 in length, toward the racecourse end. Pit area is y < -0.508.

  Source: vertices of the official arena CAD
  (2027 IEEE SoutheastCon Arena_Fusion360.f3d, June 2026), checked against
  Game Manual 2 V3.0 Figure 3.2.1. See simulation/README.md "Field accuracy"
  for the elements that are not modeled yet and why.

  Generated file. Values are CAD inches converted to meters.
-->
<sdf version="1.9">
  <world name="track">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Floor under the board. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.01826 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Field (official CAD) ===== -->
    <model name="field">
      <static>true</static>
      <link name="link">
        <!-- Board: 48 x 96 in, 23/32 in RTD sheathing (GM2 3.2), painted Onyx. -->
        <collision name="board_collision"><pose>0.00000 0.00000 -0.00913 0 0 0</pose><geometry><box><size>1.21920 2.43840 0.01826</size></box></geometry></collision>
        <visual name="board_visual"><pose>0.00000 0.00000 -0.00913 0 0 0</pose><geometry><box><size>1.21920 2.43840 0.01826</size></box></geometry><material><ambient>0.2745 0.2706 0.2667 1</ambient><diffuse>0.2745 0.2706 0.2667 1</diffuse></material></visual>
        <!-- Racecourse perimeter walls (CAD): 1 in thick, 4 in tall, Winter Chill. -->
        <collision name="race_wall_left_collision"><pose>-0.59690 0.35560 0.05080 0 0 0</pose><geometry><box><size>0.02540 1.72720 0.10160</size></box></geometry></collision>
        <visual name="race_wall_left_visual"><pose>-0.59690 0.35560 0.05080 0 0 0</pose><geometry><box><size>0.02540 1.72720 0.10160</size></box></geometry><material><ambient>0.7882 0.8235 0.8196 1</ambient><diffuse>0.7882 0.8235 0.8196 1</diffuse></material></visual>
        <collision name="race_wall_right_collision"><pose>0.59690 0.35560 0.05080 0 0 0</pose><geometry><box><size>0.02540 1.72720 0.10160</size></box></geometry></collision>
        <visual name="race_wall_right_visual"><pose>0.59690 0.35560 0.05080 0 0 0</pose><geometry><box><size>0.02540 1.72720 0.10160</size></box></geometry><material><ambient>0.7882 0.8235 0.8196 1</ambient><diffuse>0.7882 0.8235 0.8196 1</diffuse></material></visual>
        <collision name="race_wall_end_collision"><pose>0.00000 1.20650 0.05080 0 0 0</pose><geometry><box><size>1.16840 0.02540 0.10160</size></box></geometry></collision>
        <visual name="race_wall_end_visual"><pose>0.00000 1.20650 0.05080 0 0 0</pose><geometry><box><size>1.16840 0.02540 0.10160</size></box></geometry><material><ambient>0.7882 0.8235 0.8196 1</ambient><diffuse>0.7882 0.8235 0.8196 1</diffuse></material></visual>
        <!-- Pit area perimeter walls (CAD): 1 in thick, 4 in tall, Onyx
             (GM2 Appendix B: Onyx is used for the "Wall of Pit Area"). -->
        <collision name="pit_wall_left_collision"><pose>-0.59690 -0.86360 0.05080 0 0 0</pose><geometry><box><size>0.02540 0.71120 0.10160</size></box></geometry></collision>
        <visual name="pit_wall_left_visual"><pose>-0.59690 -0.86360 0.05080 0 0 0</pose><geometry><box><size>0.02540 0.71120 0.10160</size></box></geometry><material><ambient>0.2745 0.2706 0.2667 1</ambient><diffuse>0.2745 0.2706 0.2667 1</diffuse></material></visual>
        <collision name="pit_wall_right_collision"><pose>0.59690 -0.86360 0.05080 0 0 0</pose><geometry><box><size>0.02540 0.71120 0.10160</size></box></geometry></collision>
        <visual name="pit_wall_right_visual"><pose>0.59690 -0.86360 0.05080 0 0 0</pose><geometry><box><size>0.02540 0.71120 0.10160</size></box></geometry><material><ambient>0.2745 0.2706 0.2667 1</ambient><diffuse>0.2745 0.2706 0.2667 1</diffuse></material></visual>
        <collision name="pit_wall_end_collision"><pose>0.00000 -1.20650 0.05080 0 0 0</pose><geometry><box><size>1.16840 0.02540 0.10160</size></box></geometry></collision>
        <visual name="pit_wall_end_visual"><pose>0.00000 -1.20650 0.05080 0 0 0</pose><geometry><box><size>1.16840 0.02540 0.10160</size></box></geometry><material><ambient>0.2745 0.2706 0.2667 1</ambient><diffuse>0.2745 0.2706 0.2667 1</diffuse></material></visual>
        <!-- Racecourse center divider: 1 x 1 x 36 in from the June 2026 CAD.
             UNCONFIRMED: GM2 V3.0 (9/18/2026) relabels it 1"x2"x36" without
             a finished size or orientation. Update after the GDC Q&A answer. -->
        <collision name="center_divider_collision"><pose>0.00000 0.35560 0.01270 0 0 0</pose><geometry><box><size>0.02540 0.91440 0.02540</size></box></geometry></collision>
        <visual name="center_divider_visual"><pose>0.00000 0.35560 0.01270 0 0 0</pose><geometry><box><size>0.02540 0.91440 0.02540</size></box></geometry><material><ambient>0.7882 0.8235 0.8196 1</ambient><diffuse>0.7882 0.8235 0.8196 1</diffuse></material></visual>
        <!-- Divider between the pit area and the racecourse (CAD): 15.95 x 1.52 x 1 in. -->
        <collision name="pit_divider_collision"><pose>0.00006 -0.52733 0.01270 0 0 0</pose><geometry><box><size>0.40521 0.03859 0.02540</size></box></geometry></collision>
        <visual name="pit_divider_visual"><pose>0.00006 -0.52733 0.01270 0 0 0</pose><geometry><box><size>0.40521 0.03859 0.02540</size></box></geometry><material><ambient>0.7882 0.8235 0.8196 1</ambient><diffuse>0.7882 0.8235 0.8196 1</diffuse></material></visual>
        <!-- Octagon racecourse line (CAD): white tape, 0.90 in wide.
             One flat polygon per side, using the CAD outer and inner corners. -->
        <visual name="octagon_side_0"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>0.31673 -0.11176</point><point>0.31673 0.81903</point><point>0.29387 0.81903</point><point>0.29387 -0.11176</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_1"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>0.31673 0.81903</point><point>0.16550 1.01614</point><point>0.15585 0.99328</point><point>0.29387 0.81903</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_2"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>0.16550 1.01614</point><point>-0.16550 1.01614</point><point>-0.15585 0.99328</point><point>0.15585 0.99328</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_3"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>-0.16550 1.01614</point><point>-0.31674 0.81904</point><point>-0.29391 0.81904</point><point>-0.15585 0.99328</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_4"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>-0.31674 0.81904</point><point>-0.31674 -0.11175</point><point>-0.29391 -0.11175</point><point>-0.29391 0.81904</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_5"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>-0.31674 -0.11175</point><point>-0.16551 -0.30886</point><point>-0.15585 -0.28600</point><point>-0.29391 -0.11175</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_6"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>-0.16551 -0.30886</point><point>0.16549 -0.30886</point><point>0.15584 -0.28600</point><point>-0.15585 -0.28600</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="octagon_side_7"><pose>0 0 0 0 0 0</pose><geometry><polyline><point>0.16549 -0.30886</point><point>0.31673 -0.11176</point><point>0.29387 -0.11176</point><point>0.15584 -0.28600</point><height>0.00051</height></polyline></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <!-- Pit boxes 1-3 (CAD): 12 x 12 in, white, 2 in from the side walls,
             3 in apart, against the pit end wall. Numbered left to right. -->
        <visual name="pit_box_1_visual"><pose>-0.38100 -1.04140 0.00025 0 0 0</pose><geometry><box><size>0.30480 0.30480 0.00051</size></box></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="pit_box_2_visual"><pose>0.00000 -1.04140 0.00025 0 0 0</pose><geometry><box><size>0.30480 0.30480 0.00051</size></box></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <visual name="pit_box_3_visual"><pose>0.38100 -1.04140 0.00025 0 0 0</pose><geometry><box><size>0.30480 0.30480 0.00051</size></box></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
        <!-- Start box (CAD): 12 x 12 in, white. -->
        <visual name="start_box_visual"><pose>0.38100 -0.72442 0.00025 0 0 0</pose><geometry><box><size>0.30480 0.30480 0.00051</size></box></geometry><material><ambient>0.9451 0.9490 0.9333 1</ambient><diffuse>0.9451 0.9490 0.9333 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
